# Copia este archivo como .env.local y completa los valores

# ── Base de datos ────────────────────────────
DATABASE_URL=postgresql://USUARIO:CONTRASEÑA@HOST:5432/NOMBRE_BD

# ── Autenticación ────────────────────────────
NEXTAUTH_SECRET=SECRETO_ALEATORIO_MINIMO_32_CARACTERES
NEXTAUTH_URL=http://localhost:3000

# ── Dashboard ────────────────────────────────
SEMAFORO_VERDE_MIN=80
SEMAFORO_AMARILLO_MIN=60

# Atribución de órdenes en Cumplimiento: ordenador (médico que ordena) | digitador (usuario que digita).
# Al cambiarla hay que reiniciar el contenedor del dashboard.
CUMPLIMIENTO_ATRIBUCION=ordenador

# Módulos en desarrollo (desplegados pero aún no entregados): solo admin los abre (con aviso
# de vista previa); los demás roles ven "Módulo en desarrollo" y sus /api responden 403.
# Lista de secciones separadas por comas. Vacía = ninguno en desarrollo (todos liberados).
# Sin definir = productividad,inteligencia. Al cambiarla hay que reiniciar el dashboard.
# MODULOS_EN_DESARROLLO=productividad,inteligencia

# ── ETL (rutas al proceso Python) ────────────
PYTHON_PATH=python
ETL_SCRIPT_PATH=../etl/etl_autorizaciones.py
UPLOADS_DIR=../tmp_uploads
ETL_LOGS_DIR=../logs
