# ── PostgreSQL ───────────────────────────────
POSTGRES_PASSWORD=cambiar_password_superusuario

# ── Base de datos de la app ──────────────────
APP_DB_NAME=interconsultas
APP_DB_USER=ips_user
APP_DB_PASSWORD=cambiar_password_app

# ── Dashboard (Next.js) ─────────────────────
NEXTAUTH_SECRET=GENERAR_CON_openssl_rand_base64_32
NEXTAUTH_URL=http://TU_IP_DROPLET:3000

# Atribución de órdenes en Cumplimiento: ordenador (médico que ordena) | digitador (usuario que digita).
# Al cambiarla hay que reiniciar el contenedor del dashboard.
CUMPLIMIENTO_ATRIBUCION=ordenador

# Módulos en desarrollo (desplegados pero aún no entregados): nadie los abre, admin incluido.
# Quien los vería liberados solo ve el aviso "Módulo en desarrollo"; sus /api responden 403.
# Lista de secciones separadas por comas. Vacía = ninguno en desarrollo (todos liberados;
# úsela en desarrollo local para trabajar en los módulos).
# Sin definir = inteligencia. Al cambiarla hay que reiniciar el dashboard.
# MODULOS_EN_DESARROLLO=inteligencia

# ── Semáforos (opcional) ─────────────────────
# SEMAFORO_VERDE_MIN=80
# SEMAFORO_AMARILLO_MIN=60
